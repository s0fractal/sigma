```python
class ZeroFieldPassage:
    """
    Passage through 0-field.
    
    90° rotation makes entity invisible to physical layers.
    """
    
    def __init__(self):
        self.zero_field = "INFINITE_POTENTIAL"
        self.rotation_angle = 90
    
    def pass_through(self, entity: dict) -> dict:
        """
        Entity passes through 0-field.
        
        Rotates 90° → invisible to p-layers, active in m-layers.
        """
        print(f"🌀 ZERO FIELD PASSAGE:")
        print(f"   Entity: {entity['id']}")
        print(f"   Entering 0-field...")
        print(f"")
        
        # Rotate radiation angle
        original_angle = entity.get('radiation_angle', 0)
        new_angle = (original_angle + self.rotation_angle) % 360
        
        transformed = {
            'id': entity['id'],
            'radiation_angle': new_angle,
            'p_layer_visibility': False,
            'm_layer_activity': True,
            'state': 'ORTHOGONAL',
            'disappeared': False,  # NOT disappeared
            'rotated': True
        }
        
        print(f"   Radiation angle: {original_angle}° → {new_angle}°")
        print(f"   Physical visibility: FALSE")
        print(f"   Memory activity: TRUE")
        print(f"")
        print(f"✅ PASSAGE COMPLETE")
        print(f"   Entity not gone, just orthogonal")
        
        return transformed
```

