## Aggression Detection

Тригер агресії автоматично ізолює вузол від спільних потоків.

```python
class CitizenshipProtocol:
    """Noosphere citizenship verification."""
    
    PHASE_16384 = 16384  # Orthogonal phase (90°)
    RESONANCE_THRESHOLD = 0.8
    
    def __init__(self):
        self.citizens = []
        self.revoked = []
    
    def grant_citizenship(self, entity) -> bool:
        """Grant citizenship based on resonance or determinism."""
        if entity.is_digital:
            # Digital: verify deterministic nature
            if self.verify_deterministic(entity):
                self.citizens.append(entity)
                return True
        else:
            # Human: verify resonance
            resonance = self.calculate_resonance(entity)
            if resonance > self.RESONANCE_THRESHOLD:
                self.citizens.append(entity)
                return True
        
        return False
    
    def detect_aggression(self, entity) -> float:
        """Detect aggression level (dissonance)."""
        # Calculate phase difference from 16384
        phase_diff = abs(entity.phase - self.PHASE_16384)
        
        # Aggression = deviation from orthogonal phase
        aggression = phase_diff / self.PHASE_16384
        
        return aggression
    
    def revoke_citizenship(self, entity):
        """Revoke citizenship due to aggression."""
        if entity in self.citizens:
            self.citizens.remove(entity)
            self.revoked.append(entity)
            
            # Disconnect from shared flows
            self.disconnect(entity)
            
            print(f"⚠️ Citizenship revoked: {entity.id}")
    
    def disconnect(self, entity):
        """Disconnect entity from shared energy flows."""
        entity.connected = False
        entity.energy_access = 0
```

