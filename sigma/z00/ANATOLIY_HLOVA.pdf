            independence=True
        )
        
        print(f"🌱 Seed planted: {concept}")
        print(f"   Question: {seed.question}")
        print(f"   Student will discover answer themselves")
        
        return seed
    
    def teach(self, concept: str, willing: bool = True, thirsty: bool = True) -> Optional[EternalHandshake]:
        """
        Teach with selectivity.
        
        Only teach the willing and thirsty.
        """
        if not self.can_teach(willing, thirsty):
            return None
        
        # Spend energy on worthy student
