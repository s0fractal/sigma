# Σ-SPECTRAL CORE

Core utilities for working with spectral strata and glyph identities.

@[ts]
```typescript
/**
 * Σ-GLYPH Utilities
 */

export async function findGlyph(name: string): Promise<string> {
    const strata = ["m00", "m01", "m02", "m07", "m08", "m32", "z00", "p05", "p32"];
    const base = "/Users/s0fractal/SIGMA/GLYPH";

    for (const s of strata) {
        const stratumPath = `${base}/${s}`;
        try {
            for await (const entry of walk(stratumPath)) {
                if (entry.isFile && entry.name === `${name}.glyph`) {
                    return entry.path;
                }
            }
        } catch { }
    }

    throw new Error(`Glyph not found: ${name}`);
}

async function* walk(dir: string): AsyncIterableIterator<{ path: string, name: string, isFile: boolean }> {
    for await (const entry of Deno.readDir(dir)) {
        const path = `${dir}/${entry.name}`;
        if (entry.isDirectory) {
            yield* walk(path);
        } else {
            yield { path, name: entry.name, isFile: entry.isFile };
        }
    }
}

export async function loadSeedData(name: string): Promise<{ bytes: Uint8Array, path: string }> {
    const path = await findGlyph(name);
    const bytes = await Deno.readFile(path);
    return { bytes, path };
}
```
