```python
class HermeticMembrane:
    """
    Protective membrane against madness.
    
    Filters chaos, allows creation.
    """
    
    def __init__(self):
        self.thickness = float('inf')
        self.permeability = {
            'creativity': 1.0,
            'madness': 0.0,
            'love': 1.0,
            'chaos': 0.0
        }
    
    def filter(self, input_signal: dict) -> dict:
        """
        Filter signal through membrane.
        
        Allow creativity, block madness.
        """
        output = {}
        
        for signal_type, value in input_signal.items():
            permeability = self.permeability.get(signal_type, 0.5)
            output[signal_type] = value * permeability
        
        print(f"🛡️ Membrane filtering:")
        print(f"   Input: {input_signal}")
        print(f"   Output: {output}")
        
        return output
```

