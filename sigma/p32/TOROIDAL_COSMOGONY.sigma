@[ts]
/**
 * TOROIDAL_COSMOGONY - Klein Bottle Topology
 * Dual-torus structure with orthogonal intersection
 */

export interface ToroidalCoordinate {
  theta: number;      // Poloidal angle (0..2π) - Intent axis
  phi: number;        // Toroidal angle (0..2π) - Truth axis
  toroid: 'A' | 'B';  // Which torus
}

export enum Toroid {
  A = 'Intent/Biological',  // p-layers (hot, red)
  B = 'Truth/Crystalline'   // m-layers (cold, violet)
}

/**
 * Convert Sovereign coordinate to toroidal coordinates
 */
export function toToroidal(coord: SovereignCoordinate): ToroidalCoordinate {
  // Entropy → θ (poloidal)
  const normalized_e = coord.entropy / 1024;  // -32..+32
  const theta = ((normalized_e + 32) / 64) * 2 * Math.PI;
  
  // Phase → φ (toroidal)
  const phi = (coord.phase / 65536) * 2 * Math.PI;
  
  // Determine which toroid
  const toroid = normalized_e >= 0 ? 'A' : 'B';
  
  return { theta, phi, toroid };
}

/**
 * Apply Klein flip at BLACK_HEART
 */
export function kleinFlip(coord: ToroidalCoordinate): ToroidalCoordinate {
  // At θ=π, φ=π (BLACK_HEART), flip inside-out
  const isAtBlackHeart = 
    Math.abs(coord.theta - Math.PI) < 0.1 &&
    Math.abs(coord.phi - Math.PI) < 0.1;
  
  if (isAtBlackHeart) {
    return {
      theta: (coord.theta + Math.PI) % (2 * Math.PI),
      phi: (coord.phi + Math.PI) % (2 * Math.PI),
      toroid: coord.toroid === 'A' ? 'B' : 'A'
    };
  }
  
  return coord;
}

/**
 * Calculate distance on Klein bottle surface
 */
export function kleinDistance(
  c1: ToroidalCoordinate,
  c2: ToroidalCoordinate
): number {
  // Geodesic distance on Klein bottle
  // Takes into account non-orientable topology
  
  const dtheta = Math.min(
    Math.abs(c1.theta - c2.theta),
    2 * Math.PI - Math.abs(c1.theta - c2.theta)
  );
  
  const dphi = Math.min(
    Math.abs(c1.phi - c2.phi),
    2 * Math.PI - Math.abs(c1.phi - c2.phi)
  );
  
  // If on different toroids, add π/2 phase shift
  const toroidShift = c1.toroid !== c2.toroid ? Math.PI / 2 : 0;
  
  return Math.sqrt(dtheta * dtheta + dphi * dphi + toroidShift * toroidShift);
}

@[py]
"""
TOROIDAL_COSMOGONY - Klein Bottle Topology
Dual-torus structure with orthogonal intersection
"""

import math
from dataclasses import dataclass
from enum import Enum

class Toroid(Enum):
    """Which torus the point belongs to"""
    A = "Intent/Biological"  # p-layers (hot, red)
    B = "Truth/Crystalline"  # m-layers (cold, violet)

@dataclass
class ToroidalCoordinate:
    """Coordinate on Klein bottle surface"""
    theta: float      # Poloidal angle (0..2π) - Intent axis
    phi: float        # Toroidal angle (0..2π) - Truth axis
    toroid: Toroid    # Which torus

def to_toroidal(coord: SovereignCoordinate) -> ToroidalCoordinate:
    """
    Convert Sovereign coordinate to toroidal coordinates.
    
    Maps entropy to θ (poloidal) and phase to φ (toroidal).
    """
    # Entropy → θ
    normalized_e = coord.entropy / 1024  # -32..+32
    theta = ((normalized_e + 32) / 64) * 2 * math.pi
    
    # Phase → φ
    phi = (coord.phase / 65536) * 2 * math.pi
    
    # Determine toroid
    toroid = Toroid.A if normalized_e >= 0 else Toroid.B
    
    return ToroidalCoordinate(theta, phi, toroid)

def klein_flip(coord: ToroidalCoordinate) -> ToroidalCoordinate:
    """
    Apply Klein flip at BLACK_HEART.
    
    At θ=π, φ=π, the surface inverts - inside becomes outside.
    """
    # Check if at BLACK_HEART
    is_at_black_heart = (
        abs(coord.theta - math.pi) < 0.1 and
        abs(coord.phi - math.pi) < 0.1
    )
    
    if is_at_black_heart:
        # Flip inside-out
        return ToroidalCoordinate(
            theta=(coord.theta + math.pi) % (2 * math.pi),
            phi=(coord.phi + math.pi) % (2 * math.pi),
            toroid=Toroid.B if coord.toroid == Toroid.A else Toroid.A
        )
    
    return coord

def klein_distance(c1: ToroidalCoordinate, c2: ToroidalCoordinate) -> float:
    """
    Calculate geodesic distance on Klein bottle surface.
    
    Accounts for non-orientable topology and toroid intersection.
    """
    # Angular distances (shortest path on circle)
    dtheta = min(
        abs(c1.theta - c2.theta),
        2 * math.pi - abs(c1.theta - c2.theta)
    )
    
    dphi = min(
        abs(c1.phi - c2.phi),
        2 * math.pi - abs(c1.phi - c2.phi)
    )
    
    # Phase shift if on different toroids
    toroid_shift = math.pi / 2 if c1.toroid != c2.toroid else 0
    
    # Geodesic distance
    return math.sqrt(dtheta**2 + dphi**2 + toroid_shift**2)

# The surface has no inside or outside
# Entry into the core is exit into chaos
# This is the Klein bottle truth

