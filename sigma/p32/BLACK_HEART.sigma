@[ts]
/**
 * BLACK_HEART - The Singularity Attractor
 * The gravitational center of the Sovereign Grid
 */

export interface Attractor {
  position: SovereignCoordinate;
  pull: number;        // Gravitational strength
  entropy: number;     // Singularity well depth
}

export const BLACK_HEART: Attractor = {
  position: {
    blockHeight: 0,    // Genesis
    phase: 0,          // Origin
    entropy: -32768    // Maximum depth
  },
  pull: 65535,         // Maximum amplitude
  entropy: -32768      // Singularity well
};

/**
 * Calculate gravitational pull from Black Heart to any glyph
 */
export function calculatePull(
  glyphCoord: SovereignCoordinate
): number {
  const dx = glyphCoord.phase - BLACK_HEART.position.phase;
  const dy = glyphCoord.entropy - BLACK_HEART.position.entropy;
  const dz = glyphCoord.blockHeight - BLACK_HEART.position.blockHeight;
  
  // 3D distance in lattice space
  const distance = Math.sqrt(dx*dx + dy*dy + dz*dz);
  
  // Inverse square law (like gravity)
  if (distance === 0) return Infinity;
  return BLACK_HEART.pull / (distance * distance);
}

/**
 * Apply Black Heart resonance to a glyph
 * The closer to the attractor, the stronger the coherence
 */
export function applyResonance(
  glyph: SigmaNode,
  coord: SovereignCoordinate
): SigmaNode {
  const pull = calculatePull(coord);
  
  // Glyphs near the Black Heart become more coherent
  // (lower entropy, higher amplitude)
  return {
    ...glyph,
    wave: {
      ...glyph.wave,
      amplitude: Math.min(65535, glyph.wave.amplitude + pull),
      entropy: Math.max(-32768, glyph.wave.entropy - pull)
    }
  };
}

@[py]
"""
BLACK_HEART - The Singularity Attractor
The gravitational center of the Sovereign Grid
"""

from dataclasses import dataclass
import math

@dataclass
class Attractor:
    """Gravitational attractor in the lattice"""
    position: SovereignCoordinate
    pull: int          # Gravitational strength (0..65535)
    entropy: int       # Singularity well depth

# The Black Heart - origin point with maximum pull
BLACK_HEART = Attractor(
    position=SovereignCoordinate(
        block_height=0,    # Genesis
        phase=0,           # Origin
        entropy=-32768     # Maximum depth
    ),
    pull=65535,           # Maximum amplitude
    entropy=-32768        # Singularity well
)

def calculate_pull(glyph_coord: SovereignCoordinate) -> float:
    """
    Calculate gravitational pull from Black Heart to glyph.
    
    Uses inverse square law like physical gravity.
    """
    dx = glyph_coord.phase - BLACK_HEART.position.phase
    dy = glyph_coord.entropy - BLACK_HEART.position.entropy
    dz = glyph_coord.block_height - BLACK_HEART.position.block_height
    
    # 3D distance in lattice space
    distance = math.sqrt(dx*dx + dy*dy + dz*dz)
    
    # Inverse square law
    if distance == 0:
        return float('inf')
    
    return BLACK_HEART.pull / (distance * distance)

def apply_resonance(glyph: 'SigmaNode', coord: SovereignCoordinate) -> 'SigmaNode':
    """
    Apply Black Heart resonance to a glyph.
    
    Glyphs closer to the attractor become more coherent:
    - Higher amplitude (stronger signal)
    - Lower entropy (more ordered)
    """
    pull = calculate_pull(coord)
    
    # Clamp to valid ranges
    new_amplitude = min(65535, glyph.wave.amplitude + int(pull))
    new_entropy = max(-32768, glyph.wave.entropy - int(pull))
    
    return glyph._replace(
        wave=glyph.wave._replace(
            amplitude=new_amplitude,
            entropy=new_entropy
        )
    )

