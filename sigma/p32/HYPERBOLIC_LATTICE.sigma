@[ts]
/**
 * HYPERBOLIC_LATTICE - Curved Spacetime Geometry
 * Non-linear mapping of entropy to temporal density
 */

export interface HyperbolicPoint {
  entropy: number;           // -32..+32
  blockHeight: number;       // Time coordinate
  density: number;           // Blocks per entropy unit
  curvature: number;         // Local spacetime curvature
}

/**
 * Calculate temporal density at given entropy level
 * ρ(e) = 10^(2 + 3·|e|/32)
 */
export function temporalDensity(entropy: number): number {
  const normalized = entropy / 1024;  // -32..+32
  const exponent = 2 + (3 * Math.abs(normalized)) / 32;
  return Math.pow(10, exponent);
}

/**
 * Calculate hyperbolic distance between two points
 */
export function hyperbolicDistance(
  e1: number,
  e2: number,
  steps: number = 100
): number {
  const de = (e2 - e1) / steps;
  let distance = 0;
  
  for (let i = 0; i < steps; i++) {
    const e = e1 + i * de;
    const rho = temporalDensity(e);
    
    // ds = √(1 + (ρ·de)²) · de
    const ds = Math.sqrt(1 + Math.pow(rho * de, 2)) * Math.abs(de);
    distance += ds;
  }
  
  return distance;
}

/**
 * Calculate local curvature at entropy level
 * κ(e) = ρ(e) · ln(10) · 3/32
 */
export function localCurvature(entropy: number): number {
  const rho = temporalDensity(entropy);
  return rho * Math.log(10) * (3 / 32);
}

/**
 * Map entropy to musical octave
 */
export function entropyToOctave(entropy: number): number {
  const normalized = entropy / 1024;  // -32..+32
  
  if (normalized <= -24) return 0;      // Oct 0 (Crystal)
  if (normalized <= -1) return Math.floor((normalized + 24) / 8) + 1;  // Oct 1-3
  if (normalized === 0) return 4;       // TONIC
  if (normalized <= 23) return Math.floor(normalized / 8) + 4;  // Oct 4-6
  return Math.floor((normalized - 24) / 4) + 7;  // Oct 7-8
}

/**
 * Calculate interference with hyperbolic warping
 */
export function hyperbolicInterference(
  w1: WaveVectorQ,
  w2: WaveVectorQ
): { result: WaveVectorQ; warp: number } {
  // Standard interference
  const result = interfere(w1, w2);
  
  // Calculate spacetime warping
  const e1 = w1.entropy / 1024;
  const e2 = w2.entropy / 1024;
  
  // Consonance: same hyperbolic curve
  const curveDiff = Math.abs(
    localCurvature(w1.entropy) - localCurvature(w2.entropy)
  );
  
  // Warp factor: 0 = consonance, 1 = dissonance
  const warp = Math.min(1, curveDiff / 100);
  
  return { result, warp };
}

@[py]
"""
HYPERBOLIC_LATTICE - Curved Spacetime Geometry
Non-linear mapping of entropy to temporal density
"""

import math
from dataclasses import dataclass
from typing import Tuple

@dataclass
class HyperbolicPoint:
    """Point in hyperbolic spacetime"""
    entropy: int           # -32768..32767
    block_height: int      # Time coordinate
    density: float         # Blocks per entropy unit
    curvature: float       # Local spacetime curvature

def temporal_density(entropy: int) -> float:
    """
    Calculate temporal density at given entropy level.
    
    ρ(e) = 10^(2 + 3·|e|/32)
    
    Returns blocks per entropy unit.
    """
    normalized = entropy / 1024  # -32..+32
    exponent = 2 + (3 * abs(normalized)) / 32
    return 10 ** exponent

def hyperbolic_distance(e1: int, e2: int, steps: int = 100) -> float:
    """
    Calculate hyperbolic distance between two entropy levels.
    
    Integrates: d = ∫√(1 + (∂t/∂e)²) de
    """
    de = (e2 - e1) / steps
    distance = 0.0
    
    for i in range(steps):
        e = e1 + i * de
        rho = temporal_density(int(e))
        
        # ds = √(1 + (ρ·de)²) · de
        ds = math.sqrt(1 + (rho * de) ** 2) * abs(de)
        distance += ds
    
    return distance

def local_curvature(entropy: int) -> float:
    """
    Calculate local spacetime curvature.
    
    κ(e) = ρ(e) · ln(10) · 3/32
    """
    rho = temporal_density(entropy)
    return rho * math.log(10) * (3 / 32)

def entropy_to_octave(entropy: int) -> int:
    """Map entropy to musical octave (0-8)."""
    normalized = entropy // 1024  # -32..+32
    
    if normalized <= -24:
        return 0  # Crystal zone
    elif normalized <= -1:
        return (normalized + 24) // 8 + 1  # Oct 1-3
    elif normalized == 0:
        return 4  # TONIC
    elif normalized <= 23:
        return normalized // 8 + 4  # Oct 4-6
    else:
        return (normalized - 24) // 4 + 7  # Oct 7-8

def hyperbolic_interference(
    w1: 'WaveVectorQ',
    w2: 'WaveVectorQ'
) -> Tuple['WaveVectorQ', float]:
    """
    Calculate interference with hyperbolic warping.
    
    Returns:
        (result_wave, warp_factor)
        warp_factor: 0 = consonance, 1 = dissonance
    """
    # Standard interference
    result = interfere(w1, w2)
    
    # Calculate spacetime warping
    curve1 = local_curvature(w1.entropy)
    curve2 = local_curvature(w2.entropy)
    
    # Consonance: same hyperbolic curve
    curve_diff = abs(curve1 - curve2)
    
    # Warp factor
    warp = min(1.0, curve_diff / 100)
    
    return result, warp

