# T - Thrush

The Thrush turns the stream around. It applies the second argument to the first.
T x f = f x.

🌊

@[ts]
export const T = (x: any) => (f: (x: any) => any) => f(x);

@[rs]
pub fn T<T, F, U>(x: T, f: F) -> U
where
    F: Fn(T) -> U,
{
    f(x)
}

@[sh]
T() {
    local x="$1"
    local f="$2"
    $f $x
}

