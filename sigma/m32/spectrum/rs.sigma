--- 
layer: m32
GLYPH: rs
TYPE: submodule
PATH: 'rs/'
HEX: '#FF4433'
SYNTAX: rust
MUTE: '"/// "'
LIFT: '#![no_std]'
🪨MASS: 0.9
🌀ENTROPY: 0.1
IMPORT: 'use crate::%p;'
🧬QDNA:
  brew: "brew install rustup && rustup-init -y"
  sh: "curl https://sh.rustup.rs -sSf | sh -s -- -y"
🕸️EDGES:
  - edge: "edge://brew/rust/1.75"
    check: "brew list rust >/dev/null 2>&1"
    resolve: "brew install rust"
    channel: brew
    cost: 0.2
    ttl: 86400
  - edge: "edge://sh/rust/1.75"
    check: "command -v rustc >/dev/null 2>&1"
    resolve: "curl https://sh.rustup.rs -sSf | sh -s -- -y"
    channel: sh
    cost: 0.4
    ttl: 86400
🧬DNA: rs
---

