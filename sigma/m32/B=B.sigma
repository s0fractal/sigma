B - Composition Axiom

Composition is the bridge between moments. The Composition Axiom chains two functions together, passing the output of one as the input to the next.
B f g x = f (g x).

🌊

@[ts]

// 🔗 Implicit Gravity: No imports required. Dependencies are in the DNA.
export const B = <A, B, C>(f: (y: B) => C) => (g: (x: A) => B) => (x: A): C => f(g(x));


@[rs]

// 🔗 Native implementation
pub fn B<A, B, C, F, G>(f: F, g: G, x: A) -> C
where
    F: Fn(B) -> C,
    G: Fn(A) -> B,
{
    f(g(x))
}


@[sh]

# 🔗 Shell implementation
B() {
    local f="$1"
    local g="$2"
    local x="$3"
    echo "B-Composition: $f ($g $x)"
}


